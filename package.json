{
  "name": "deeptick",
  "version": "1.0.0",
  "private": true,
  "description": "DeepTick - AI-powered institutional-grade research platform",
  "scripts": {
    "dev": "bun run --parallel dev:server dev:client",
    "dev:server": "cd server && bun run dev",
    "dev:client": "cd client/deeptick && bun run dev",
    "build": "bun run --parallel build:server build:client",
    "build:server": "cd server && bun run build",
    "build:client": "cd client/deeptick && bun run build",
    "start": "bun run --parallel start:server start:client",
    "start:server": "cd server && bun start",
    "start:client": "cd client/deeptick && bun start",
    "install:all": "cd server && bun install && cd ../client/deeptick && bun install"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
