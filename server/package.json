{
  "name": "deeptick-stock-researcher-server",
  "version": "1.0.0",
  "description": "Stock Researcher Agent Server - LangGraph-based research assistant",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/websocket": "^0.2.8",

    "@langchain/anthropic": "^1.3.17",
    "@langchain/community": "^1.1.15",
    "@langchain/core": "^1.1.24",
    "@langchain/exa": "^1.0.1",
    "@langchain/langgraph": "^1.1.4",
    "@langchain/openai": "^1.2.7",
    "deepagents": "^1.7.5",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.35.0",
    "drizzle-zod": "^0.5.0",
    "elysia": "^1.4.24",
    "exa-js": "^1.0.0",
    "langchain": "^1.2.23",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.0",
    "typebox": "^1.0.81",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.26.0",
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "eslint": "^9.13.0",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "vitest": "^2.1.0",
    "@vitest/ui": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
