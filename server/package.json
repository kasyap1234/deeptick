{
  "name": "deeptick-stock-researcher-server",
  "version": "1.0.0",
  "description": "Stock Researcher Agent Server - LangGraph-based research assistant",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=bun",
    "dev": "bun --watch src/index.ts",
    "start": "bun dist/index.js",
    "lint": "eslint src/**/*.ts",
    "typecheck": "NODE_OPTIONS='--max-old-space-size=8192' tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/openapi": "^1.4.14",
    "@elysiajs/websocket": "^0.2.8",
    "@langchain/community": "^1.1.19",
    "@langchain/core": "^1.1.28",
    "@langchain/exa": "^1.0.1",
    "@langchain/langgraph": "^1.1.5",
    "@langchain/openai": "^1.2.10",
    "better-auth": "^1.4.19",
    "deepagents": "^1.8.1",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "elysia": "^1.4.25",
    "exa-js": "^2.4.0",
    "langchain": "^1.2.27",
    "pg": "^8.18.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.8",
    "typebox": "^1.1.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@types/pg": "^8.16.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitest/ui": "^4.0.18",
    "drizzle-kit": "^0.31.9",
    "eslint": "^10.0.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "@langchain/core": "$@langchain/core",
    "@langchain/langgraph": "$@langchain/langgraph",
    "langchain": "$langchain"
  }
}