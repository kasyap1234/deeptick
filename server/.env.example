# DeepTick Stock Researcher Agent Server
# Environment Configuration

# ============================================================================
# REQUIRED: Database
# ============================================================================

DATABASE_URL=postgresql://user:password@localhost:5432/deeptick

# ============================================================================
# REQUIRED: Auth (Better Auth)
# ============================================================================

BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=replace_with_a_long_random_string_at_least_32_chars

# Optional: comma-separated origins
# TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ============================================================================
# REQUIRED: DigitalOcean Gradient AI Platform
# ============================================================================

# Get DO API Token: https://cloud.digitalocean.com/account/api/tokens
DO_GENAI_API_KEY=your_digital_ocean_api_token_here

# Optional (default: https://inference.do-ai.run/v1)
# DO_GENAI_ENDPOINT=https://inference.do-ai.run/v1
#
# Optional: OpenAI API key (used only for embeddings — DO GenAI doesn't support embeddings)
# OPENAI_API_KEY=

# Get Project ID: DigitalOcean Console -> AI Platform -> Settings -> Project ID
# Or go directly to: https://cloud.digitalocean.com/ai
GRADIENT_PROJECT_ID=your_gradient_project_id_here

# Optional: Region (default: tor1)
GRADIENT_REGION=tor1

# Optional: Model UUID (auto-detected if not provided)
# GRADIENT_MODEL_UUID=

# Optional: Use a pre-configured Gradient agent directly (skips KB/agent setup)
# GRADIENT_AGENT_ENDPOINT=
# GRADIENT_AGENT_ACCESS_KEY=

# Optional: Required if creating Gradient knowledge bases
# GRADIENT_KB_EMBEDDING_MODEL_URN=

# ============================================================================
# REQUIRED: Search API
# ============================================================================
EXASEARCH_API_KEY=your_exa_api_key_here

# Legacy key name (supported)
# EXA_API_KEY=

# ============================================================================
# OPTIONAL: Stock Data
# ============================================================================
# ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key

# ============================================================================
# OPTIONAL: Deep Research model overrides
# ============================================================================
# When using DigitalOcean only (DO_GENAI_API_KEY + inference.do-ai.run): the
# "provider" is OpenAI-compatible (one endpoint, one API key). Use DigitalOcean's
# model IDs from https://docs.digitalocean.com/products/gradient-ai-platform/details/models/
# e.g. openai-gpt-oss-120b, openai-gpt-4o, anthropic-claude-5-sonnet, llama3.3-70b-instruct
#
# Default: openai-gpt-oss-120b (DigitalOcean). Override for other models:
# DEEP_RESEARCH_ORCHESTRATOR_MODEL=openai-gpt-oss-120b
# DEEP_RESEARCH_SUBAGENT_MODEL=openai-gpt-oss-120b
# DEEP_RESEARCH_AUDITOR_MODEL=openai-gpt-oss-120b

# ============================================================================
# OPTIONAL: LangSmith tracing
# ============================================================================

# LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=deeptick-stock-researcher

# ============================================================================
# OPTIONAL: Vector search tuning
# ============================================================================

# SIMILARITY_THRESHOLD=0.75
# MAX_RESULTS=10

# ============================================================================
# SERVER CONFIG
# ============================================================================
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# ============================================================================
# QUICK SETUP
# ============================================================================
# 1. Get DO API Token:
#    https://cloud.digitalocean.com/account/api/tokens
#    Create new token with "read" and "write" scopes
#
# 2. Get Gradient Project ID:
#    https://cloud.digitalocean.com/ai
#    Click on your project -> Settings -> General
#
# 3. Get Exa API Key:
#    https://dashboard.exa.ai/
#
# 4. Run:
#    bun install
#    bun run dev
# ============================================================================
