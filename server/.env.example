# DeepTick Stock Researcher Agent Server
# Environment Configuration

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Primary database URL (used by default)
# Supports both local PostgreSQL and DigitalOcean Managed PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/deeptick

# Alternative: Vector DB Mode Selection
# Options: 'database_url' (default), 'local', 'managed'
VECTOR_DB_MODE=database_url

# Local PostgreSQL (for development)
LOCAL_DATABASE_URL=postgresql://user:password@localhost:5432/deeptick

# DigitalOcean Managed PostgreSQL (for production)
MANAGED_DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# ============================================================================
# AI/LLM PROVIDERS (DigitalOcean GenAI Platform)
# ============================================================================

# Digital Ocean GenAI API Configuration
DO_GENAI_API_KEY=your_digital_ocean_genai_api_key_here
DO_GENAI_ENDPOINT=https://api.genai.digitalocean.com/v1

# Deep Research Model Configuration
DEEP_RESEARCH_ORCHESTRATOR_MODEL=claude-sonnet-4-20250514
DEEP_RESEARCH_SUBAGENT_MODEL=claude-sonnet-4-20250514
DEEP_RESEARCH_AUDITOR_MODEL=claude-sonnet-4-20250514

# ============================================================================
# SEARCH PROVIDERS
# ============================================================================

# Exa AI for Web Search (Primary)
EXASEARCH_API_KEY=your_exa_api_key_here

# Legacy fallback (optional)
EXA_API_KEY=your_exa_api_key_here

# ============================================================================
# STOCK DATA PROVIDERS
# ============================================================================

# Alpha Vantage API (for real-time stock data)
# Get free API key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# ============================================================================
# LANGSMITH TRACING (Optional)
# ============================================================================

LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_key_here
LANGCHAIN_PROJECT=deeptick-stock-researcher

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# ============================================================================
# VECTOR STORE CONFIGURATION
# ============================================================================

VECTOR_DIMENSION=1536
VECTOR_TABLE_NAME=stock_research_embeddings

# Similarity thresholds for query routing
SIMILARITY_THRESHOLD=0.9
PARTIAL_MATCH_THRESHOLD=0.8

# ============================================================================
# SECURITY & CORS
# ============================================================================

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================================================
# QUICK START
# ============================================================================

# 1. Copy this file to .env
# cp .env.example .env

# 2. Install dependencies
# bun install

# 3. Setup database (ensure PostgreSQL 14+ with pgvector extension)
# bun run db:generate
# bun run db:migrate

# 4. Run development server
# bun run dev

# 5. Build for production
# bun run build
# bun start

# ============================================================================
# API ENDPOINTS
# ============================================================================

# Research API
# POST   /api/research                 - Submit research query
# GET    /api/research                 - List all research jobs
# GET    /api/research/search?q=query  - Search research history
# GET    /api/research/:jobId          - Get research by ID
# GET    /api/research/:jobId/report   - Get full research report

# Chat API
# POST   /api/chat/conversations              - Create conversation
# GET    /api/chat/conversations              - List conversations
# GET    /api/chat/conversations/:id          - Get conversation
# GET    /api/chat/conversations/:id/messages - Get messages
# POST   /api/chat/conversations/:id/messages - Send message
# POST   /api/chat/conversations/:id/stream   - Stream message response
# GET    /api/chat/search?q=query             - Search conversations
# DELETE /api/chat/conversations/:id          - Delete conversation

# WebSocket Endpoints
# WS     /ws/research/:jobId?               - Research progress stream
# WS     /ws/chat/:conversationId           - Chat streaming

# ============================================================================
# FEATURES
# ============================================================================

# Deep Multi-Agent Research (18 specialized subagents)
# Smart Query Routing (Vector DB cache check)
# Gradient AI Integration (DigitalOcean)
# Real-time Stock Data (Alpha Vantage)
# Streaming Chat Responses
# Institutional-Grade Research Reports
# Vector Search & Semantic Similarity
# Conversation Memory & Context
